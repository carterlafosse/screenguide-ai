# server/.env.example: copy to server/.env and fill in. Never commit server/.env.
# Placeholder values only.

NODE_ENV=development
PORT=4001                        # Resolvd uses 4000
TRUST_PROXY_HOPS=1               # proxies in front of the API (Vercel → Render); sets Express 'trust proxy'
LOG_LEVEL=info                   # fatal | error | warn | info | debug | trace | silent

# Runtime connection: the API always connects as resolvd_app (RLS applies to it).
DATABASE_URL=postgres://resolvd_app:CHANGE_ME_APP_PASSWORD@localhost:5432/screenguide_dev
# Migrations and seeds run as resolvd_owner.
MIGRATION_DATABASE_URL=postgres://resolvd_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/screenguide_dev

JWT_SECRET=                      # 48+ random bytes, hex
CLIENT_ORIGIN=http://127.0.0.1:5174   # different host from Resolvd's localhost:5173 so the resolvd_token cookies don't collide
PUBLIC_WS_URL=ws://127.0.0.1:4001/ws
ENCRYPTION_KEY=                  # 32 random bytes, base64

ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_MOCK=false

DEEPGRAM_API_KEY=                # optional → Web Speech fallback
ELEVENLABS_API_KEY=              # optional → speechSynthesis fallback
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

RESEND_API_KEY=                  # optional in dev (emails logged)
EMAIL_FROM="ScreenGuide <help@yourdomain.com>"

PRIVACY_CONTACT_EMAIL=
DISABLE_PLAN_LIMITS=false
DEMO_RESET=false
