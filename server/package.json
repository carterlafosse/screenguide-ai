{
  "name": "screenguide-server",
  "version": "0.0.0",
  "private": true,
  "description": "ScreenGuide AI API: Express 5, raw SQL with pg, WebSockets and pg-boss jobs.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo.js",
    "kb:build": "node scripts/build-knowledge.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "resend": "6.37.0",
    "swagger-ui-express": "5.0.1",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "vitest": "5.1.0"
  }
}
